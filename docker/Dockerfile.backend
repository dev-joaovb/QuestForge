FROM node:22-alpine

WORKDIR /app

# Dependências do Prisma e do pipeline OCR (Tesseract + Poppler)
RUN apk add --no-cache \
    openssl \
    poppler-utils \
    font-dejavu \
    tesseract-ocr \
    tesseract-ocr-data-por \
    tesseract-ocr-data-eng

COPY package.json package-lock.json* ./
COPY prisma ./prisma/

RUN npm install

# Gera o Prisma Client para o schema atual
RUN npx prisma generate

COPY tsconfig.json ./
COPY backend ./backend/
COPY src ./src/
COPY server.ts index.html vite.config.ts ./

EXPOSE 3333

CMD ["npx", "tsx", "backend/src/server.ts"]
