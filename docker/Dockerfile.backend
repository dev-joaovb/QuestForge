FROM node:22-alpine

WORKDIR /app

# Instala dependências necessárias para o Prisma em Alpine Linux
RUN apk add --no-cache openssl

COPY package.json package-lock.json* ./
COPY prisma ./prisma/

RUN npm install

# Gera o Prisma Client para o schema atual
RUN npx prisma generate

COPY tsconfig.json ./
COPY backend ./backend/
COPY src ./src/
COPY server.ts index.html vite.config.ts ./

EXPOSE 3333

CMD ["npx", "tsx", "server.ts"]
