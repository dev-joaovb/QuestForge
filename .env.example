# ==========================================
# DATABASE (PostgreSQL)
# ==========================================
# Variáveis utilizadas pelo container PostgreSQL no Docker Compose
# Preencha manualmente no seu arquivo .env local. Nunca versione credenciais reais.
POSTGRES_USER="SEU_USUARIO_POSTGRES"
POSTGRES_PASSWORD="SUA_SENHA_POSTGRES"
POSTGRES_DB="questforge"
POSTGRES_PORT="5432"

# Obrigatória para persistência de dados via Prisma ORM.
# Em execução no host local, use @localhost:5432.
# No container do backend via Docker Compose, o serviço sobrescreve o host interno para @postgresql:5432.
DATABASE_URL="postgresql://SEU_USUARIO_POSTGRES:SUA_SENHA_POSTGRES@localhost:5432/questforge?schema=public"

# ==========================================
# AUTHENTICATION & SESSIONS
# ==========================================
# Obrigatória. Gere manualmente uma chave longa e aleatória (mínimo 32 caracteres) para assinar sessões HttpOnly.
SESSION_SECRET="COLOQUE_SUA_CHAVE_SECRETA_AQUI_MIN_32_CHARS"

# ==========================================
# OLLAMA (IA Local)
# ==========================================
# URL base do servidor Ollama para estruturação de questões e análise educacional.
# No host local: http://localhost:11434 | Na rede Docker: http://ollama:11434
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_PORT="11434"

# Nome do modelo local configurado no Ollama (opcional na fundação; nenhum modelo grande é baixado automaticamente).
OLLAMA_MODEL="SEU_MODELO_AQUI"
# Tempo limite em milissegundos para chamadas de extração inteligente ao Ollama (padrão: 45000)
OLLAMA_TIMEOUT_MS="45000"
# Quantidade máxima de questões estruturadas extraídas por documento/lote (padrão: 100)
AI_MAX_QUESTIONS_PER_DOCUMENT="100"

# ==========================================
# MINIO / OBJECT STORAGE (Armazenamento de PDFs)
# ==========================================
# Configuração do armazenamento de documentos de provas e gabaritos.
# No host local: localhost | Na rede Docker: minio
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_CONSOLE_PORT="9001"
MINIO_ACCESS_KEY="SEU_USUARIO_MINIO"
MINIO_SECRET_KEY="SUA_SENHA_MINIO"
MINIO_BUCKET="questforge-documents"
MINIO_USE_SSL="false"

# ==========================================
# PDF PROCESSING LIMITS (Sprint 3)
# ==========================================
# Tamanho máximo permitido para upload de PDF em bytes (padrão: 20 MB = 20971520)
PDF_MAX_FILE_SIZE_BYTES="20971520"
# Número máximo de páginas processadas por documento PDF (padrão: 150)
PDF_MAX_PAGES="150"
# Tempo limite em milissegundos para extração de texto digital de PDF (padrão: 15000)
PDF_EXTRACTION_TIMEOUT_MS="15000"

# ==========================================
# APPLICATION
# ==========================================
NODE_ENV="development"
PORT="3000"
BACKEND_PORT="3333"
FRONTEND_PORT="5173"
FRONTEND_URL="http://localhost:3000"
APP_URL="MY_APP_URL"
GEMINI_API_KEY="MY_GEMINI_API_KEY"



