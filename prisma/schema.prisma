// ============================================================================
// QUESTFORGE — PRISMA SCHEMA (SPRINT 2: BANCO DE QUESTÕES E PROVAS DE ORIGEM)
// ============================================================================
// Modelos ativos: User, UserSession, Exam, Question e Alternative.
// Os modelos de processamento PDF/OCR, IA e Simulados pertencem às Sprints 3 a 6.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  ACTIVE
  NEEDS_REVIEW
  ARCHIVED
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     UserSession[]
  exams        Exam[]
  questions    Question[]

  @@map("users")
}

model UserSession {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Exam {
  id          String     @id @default(uuid())
  userId      String
  title       String
  institution String?
  board       String?
  year        Int?
  position    String?
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([userId])
  @@index([board])
  @@index([year])
  @@map("exams")
}

model Question {
  id             String              @id @default(uuid())
  userId         String
  examId         String?
  originalNumber Int?
  statement      String
  type           QuestionType        @default(MULTIPLE_CHOICE)
  subject        String
  topic          String?
  subtopic       String?
  board          String?
  examTitle      String?
  year           Int?
  difficulty     QuestionDifficulty?
  correctAnswer  String?
  explanation    String?
  sourcePage     Int?
  status         QuestionStatus      @default(ACTIVE)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam         Exam?         @relation(fields: [examId], references: [id], onDelete: SetNull)
  alternatives Alternative[]

  @@index([userId, createdAt])
  @@index([userId, subject])
  @@index([userId, topic])
  @@index([userId, board])
  @@index([examId])
  @@map("questions")
}

model Alternative {
  id         String   @id @default(uuid())
  questionId String
  letter     String
  text       String
  position   Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, letter])
  @@unique([questionId, position])
  @@index([questionId])
  @@map("alternatives")
}
