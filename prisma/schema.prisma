// QUESTFORGE — PRISMA SCHEMA (SPRINT 5: GABARITOS OFICIAIS)
// ============================================================================
// Modelos ativos: User, UserSession, Exam, Question, Alternative,
// PdfDocument, OfficialAnswerKey, OfficialAnswerKeyItem.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentType {
  EXAM
  ANSWER_KEY
}

enum AnswerKeyType {
  PRELIMINARY
  FINAL
  RECTIFIED
}

enum AnswerKeyStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
  ARCHIVED
}

enum AnswerKeyItemStatus {
  ACTIVE
  ANNULLED
  CHANGED
  NEEDS_REVIEW
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  ACTIVE
  NEEDS_REVIEW
  ARCHIVED
}

enum DocumentProcessingStatus {
  UPLOADED
  PROCESSING
  COMPLETED
  NEEDS_OCR
  FAILED
}

model User {
  id                 String              @id @default(uuid())
  name               String
  email              String              @unique
  passwordHash       String
  avatarUrl          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sessions           UserSession[]
  exams              Exam[]
  questions          Question[]
  pdfDocuments       PdfDocument[]
  officialAnswerKeys OfficialAnswerKey[]

  @@map("users")
}

model UserSession {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Exam {
  id          String   @id @default(uuid())
  userId      String
  title       String
  institution String?
  board       String?
  year        Int?
  position    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions          Question[]
  pdfDocuments       PdfDocument[]
  officialAnswerKeys OfficialAnswerKey[]

  @@index([userId])
  @@index([board])
  @@index([year])
  @@map("exams")
}

model PdfDocument {
  id                 String                   @id @default(uuid())
  userId             String
  examId             String?
  documentType       DocumentType             @default(EXAM)
  originalName       String
  mimeType           String
  sizeBytes          Int
  storageBucket      String
  objectKey          String                   @unique
  checksumSha256     String
  status             DocumentProcessingStatus @default(UPLOADED)
  pageCount          Int?
  extractedText      String?
  extractedCharCount Int?
  requiresOcr        Boolean                  @default(false)
  errorMessage       String?
  processedAt        DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam               Exam?               @relation(fields: [examId], references: [id], onDelete: SetNull)
  officialAnswerKeys OfficialAnswerKey[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([examId])
  @@index([documentType])
  @@map("pdf_documents")
}

model Question {
  id             String              @id @default(uuid())
  userId         String
  examId         String?
  originalNumber Int?
  statement      String
  type           QuestionType        @default(MULTIPLE_CHOICE)
  subject        String
  topic          String?
  subtopic       String?
  board          String?
  examTitle      String?
  year           Int?
  difficulty     QuestionDifficulty?
  correctAnswer  String?
  explanation    String?
  sourcePage     Int?
  status         QuestionStatus      @default(ACTIVE)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam           Exam?                   @relation(fields: [examId], references: [id], onDelete: SetNull)
  alternatives   Alternative[]
  answerKeyItems OfficialAnswerKeyItem[]

  @@index([userId, createdAt])
  @@index([userId, subject])
  @@index([userId, topic])
  @@index([userId, board])
  @@index([examId])
  @@map("questions")
}

model Alternative {
  id         String @id @default(uuid())
  questionId String
  letter     String
  text       String
  position   Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, letter])
  @@unique([questionId, position])
  @@index([questionId])
  @@map("alternatives")
}

model OfficialAnswerKey {
  id              String          @id @default(uuid())
  userId          String
  examId          String
  pdfDocumentId   String?
  type            AnswerKeyType   @default(PRELIMINARY)
  status          AnswerKeyStatus @default(DRAFT)
  version         Int             @default(1)
  isCurrent       Boolean         @default(false)
  publicationDate DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam        Exam                    @relation(fields: [examId], references: [id], onDelete: Cascade)
  pdfDocument PdfDocument?            @relation(fields: [pdfDocumentId], references: [id], onDelete: SetNull)
  items       OfficialAnswerKeyItem[]

  @@unique([examId, type, version])
  @@index([userId])
  @@index([examId, isCurrent])
  @@index([examId, status])
  @@index([pdfDocumentId])
  @@map("official_answer_keys")
}

model OfficialAnswerKeyItem {
  id             String              @id @default(uuid())
  answerKeyId    String
  questionNumber Int
  questionId     String?
  correctAnswer  String?
  previousAnswer String?
  status         AnswerKeyItemStatus @default(ACTIVE)
  isAnnulled     Boolean             @default(false)
  justification  String?
  textEvidence   String?
  confidence     Float?
  sourcePage     Int?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  answerKey OfficialAnswerKey @relation(fields: [answerKeyId], references: [id], onDelete: Cascade)
  question  Question?         @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@unique([answerKeyId, questionNumber])
  @@index([answerKeyId, status])
  @@index([questionId])
  @@map("official_answer_key_items")
}
